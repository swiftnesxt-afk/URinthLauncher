<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp" android:layout_height="match_parent"
    android:layout_marginEnd="6dp"
    app:cardBackgroundColor="#0A2029" app:strokeColor="#087C7C" app:strokeWidth="1dp" app:cardCornerRadius="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <ImageView android:id="@+id/instance_art" android:layout_width="match_parent" android:layout_height="105dp"
            android:scaleType="centerCrop" android:src="@drawable/modrinth_landscape" android:contentDescription="@null"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:gravity="center_vertical" android:padding="7dp">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_modrinth" android:contentDescription="@null"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical">
                <TextView android:id="@+id/instance_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="URinthH" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                <TextView android:id="@+id/instance_version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vannila 26.3" android:textColor="#A3C2C2" android:textSize="10sp"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/instance_play"
                android:layout_width="64dp" android:layout_height="32dp" android:minWidth="0dp" android:minHeight="0dp"
                android:paddingHorizontal="8dp" android:text="▷ Play" android:textAllCaps="false" android:textColor="#001A18" android:textSize="10sp"
                app:backgroundTint="#00F5D4" app:cornerRadius="16dp"/>
            <ImageButton android:id="@+id/instance_menu" android:layout_width="32dp" android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_native_more_vert" android:contentDescription="More instance actions"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>