<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragment_menu_main" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#020D18">

    <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:gravity="center_vertical"
        android:paddingStart="12dp" android:paddingEnd="14dp" android:background="#03101B">
        <TextView android:layout_width="38dp" android:layout_height="match_parent" android:gravity="center" android:text="☰"
            android:textColor="#E8F5FF" android:textSize="28sp"/>
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_modrinth" android:contentDescription="@null"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="9dp"
            android:text="Modrinth" android:textColor="#F4F7FB" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Launcher"
            android:textColor="#18F0C4" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="18dp"
            android:text="|" android:textColor="#16EAC1" android:textSize="18sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp"
            android:text="Made By: Macase, Nile" android:textColor="#18E8C3" android:textSize="11sp" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">

        <LinearLayout android:layout_width="216dp" android:layout_height="match_parent" android:orientation="vertical"
            android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:background="#04111D">

            <LinearLayout android:id="@+id/modrinth_home" style="@style/ModrinthSideRow"><ImageView style="@style/ModrinthSideIcon" android:src="@drawable/ic_px_home"/><TextView style="@style/ModrinthSideText" android:text="Home"/></LinearLayout>
            <LinearLayout android:id="@+id/modrinth_instances" style="@style/ModrinthSideRow"><ImageView style="@style/ModrinthSideIcon" android:src="@drawable/ic_px_image"/><TextView style="@style/ModrinthSideText" android:text="Instances"/></LinearLayout>
            <LinearLayout android:id="@+id/modrinth_modpacks" style="@style/ModrinthSideRow"><ImageView style="@style/ModrinthSideIcon" android:src="@drawable/ic_px_experiment"/><TextView style="@style/ModrinthSideText" android:text="Modpacks"/></LinearLayout>
            <LinearLayout android:id="@+id/modrinth_mods" style="@style/ModrinthSideRow"><ImageView style="@style/ModrinthSideIcon" android:src="@drawable/ic_px_zap"/><TextView style="@style/ModrinthSideText" android:text="Mods"/></LinearLayout>
            <LinearLayout android:id="@+id/modrinth_shaders" style="@style/ModrinthSideRow"><ImageView style="@style/ModrinthSideIcon" android:src="@drawable/ic_px_image_renderer"/><TextView style="@style/ModrinthSideText" android:text="Shaders"/></LinearLayout>
            <LinearLayout android:id="@+id/modrinth_worlds" style="@style/ModrinthSideRow"><ImageView style="@style/ModrinthSideIcon" android:src="@drawable/ic_px_dynamic"/><TextView style="@style/ModrinthSideText" android:text="Worlds"/></LinearLayout>
            <LinearLayout android:id="@+id/modrinth_resourcepacks" style="@style/ModrinthSideRow"><ImageView style="@style/ModrinthSideIcon" android:src="@drawable/ic_px_folder"/><TextView style="@style/ModrinthSideText" android:text="Resource Packs"/></LinearLayout>
            <LinearLayout android:id="@+id/modrinth_servers" style="@style/ModrinthSideRow"><ImageView style="@style/ModrinthSideIcon" android:src="@drawable/ic_px_console"/><TextView style="@style/ModrinthSideText" android:text="Servers"/></LinearLayout>
            <LinearLayout android:id="@+id/modrinth_settings" style="@style/ModrinthSideRow"><ImageView style="@style/ModrinthSideIcon" android:src="@drawable/ic_px_sliders"/><TextView style="@style/ModrinthSideText" android:text="Settings"/></LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:orientation="horizontal" android:gravity="center_vertical"
                android:padding="8dp" android:background="#071D2A">
                <ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_modrinth" android:contentDescription="@null"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Modrinth" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Better Minecraft" android:textColor="#B9C8D2" android:textSize="10sp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Together" android:textColor="#B9C8D2" android:textSize="10sp"/>
                </LinearLayout>
                <TextView android:layout_width="18dp" android:layout_height="wrap_content" android:text="›" android:textColor="#16EAC1" android:textSize="25sp"/>
            </LinearLayout>
        </LinearLayout>

        <ScrollView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:fillViewport="true" android:background="#020D18">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="188dp" android:orientation="vertical"
                    android:padding="20dp" android:background="#10404A">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="“Play, Explore,"
                        android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Create, Together.”"
                        android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                        android:text="The best Minecraft experience,&#10;now on your Android device." android:textColor="#D3E6EB" android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="10dp" android:orientation="horizontal">
                    <LinearLayout style="@style/ModrinthCard" android:layout_weight="1"><View android:layout_width="match_parent" android:layout_height="65dp" android:background="#5A3758"/><TextView style="@style/ModrinthCardTitle" android:text="URinthH"/><TextView style="@style/ModrinthCardMeta" android:text="Vanilla 26.3"/><TextView android:id="@+id/instance_play_1" style="@style/ModrinthPlay" android:text="▷ Play"/></LinearLayout>
                    <LinearLayout style="@style/ModrinthCard" android:layout_weight="1"><View android:layout_width="match_parent" android:layout_height="65dp" android:background="#335F72"/><TextView style="@style/ModrinthCardTitle" android:text="URinthH"/><TextView style="@style/ModrinthCardMeta" android:text="Vanilla 26.3"/><TextView android:id="@+id/instance_play_2" style="@style/ModrinthPlay" android:text="▷ Play"/></LinearLayout>
                    <LinearLayout style="@style/ModrinthCard" android:layout_weight="1"><View android:layout_width="match_parent" android:layout_height="65dp" android:background="#8B4A2D"/><TextView style="@style/ModrinthCardTitle" android:text="URinthH"/><TextView style="@style/ModrinthCardMeta" android:text="Vanilla 26.3"/><TextView android:id="@+id/instance_play_3" style="@style/ModrinthPlay" android:text="▷ Play"/></LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="120dp" android:layout_marginTop="10dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="34dp" android:text="★  Latest Mods" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="86dp" android:orientation="horizontal">
                        <TextView style="@style/ModrinthLatest" android:text="🔥  Sodium&#10;NeoForge 1.21.1&#10;&#10;Add"/>
                        <TextView style="@style/ModrinthLatest" android:text="⚡  Lithium&#10;Fabric 1.21.1&#10;&#10;Add"/>
                        <TextView style="@style/ModrinthLatest" android:text="🌸  Iris&#10;Fabric 1.21.1&#10;&#10;Add"/>
                        <TextView style="@style/ModrinthLatest" android:text="◉  Distant Horizons&#10;Forge 1.21.1&#10;&#10;Add"/>
                        <TextView style="@style/ModrinthLatest" android:text="◈  Xaero's Minimap&#10;Forge 1.21.1&#10;&#10;Add"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout android:layout_width="315dp" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:background="#020D18">
            <TextView android:id="@+id/add_account_card" style="@style/ModrinthActionTall" android:text="🟩  Add Account&#10;       Sign in to your Minecraft account&#10;&#10;       ＋  Add Account"/>
            <TextView android:id="@+id/check_updates_card" style="@style/ModrinthActionTall" android:text="◉  Check Updates&#10;       Check for new versions and fixes&#10;                                           ›"/>
            <TextView android:id="@+id/ultra_card" style="@style/ModrinthActionTall" android:text="🚀  UrInthUltra Mode&#10;       Enable ultra performance mode&#10;                                   OFF   ON"/>
            <TextView android:id="@+id/discord_card" style="@style/ModrinthDiscord" android:text="◉  Discord                                      ›"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>