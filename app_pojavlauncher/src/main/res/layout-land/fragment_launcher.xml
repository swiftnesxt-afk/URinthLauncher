<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/target_launcher_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <!-- Invisible interaction regions over the exact reference artwork. -->
    <FrameLayout
        android:id="@+id/interaction_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View android:id="@+id/add_account_button"
            android:layout_width="290dp" android:layout_height="72dp"
            android:layout_gravity="top|end" android:layout_marginTop="74dp" android:layout_marginEnd="20dp"
            android:background="@android:color/transparent" android:clickable="true" />

        <View android:id="@+id/check_updates_button"
            android:layout_width="290dp" android:layout_height="62dp"
            android:layout_gravity="top|end" android:layout_marginTop="197dp" android:layout_marginEnd="20dp"
            android:background="@android:color/transparent" android:clickable="true" />

        <View android:id="@+id/urinth_ultra_switch"
            android:layout_width="290dp" android:layout_height="65dp"
            android:layout_gravity="top|end" android:layout_marginTop="258dp" android:layout_marginEnd="20dp"
            android:background="@android:color/transparent" android:clickable="true" />

        <View android:id="@+id/discord_button"
            android:layout_width="290dp" android:layout_height="78dp"
            android:layout_gravity="top|end" android:layout_marginTop="331dp" android:layout_marginEnd="20dp"
            android:background="@android:color/transparent" android:clickable="true" />

        <View android:id="@+id/instance_play_button"
            android:layout_width="760dp" android:layout_height="95dp"
            android:layout_gravity="top|start" android:layout_marginTop="270dp" android:layout_marginStart="230dp"
            android:background="@android:color/transparent" android:clickable="true" />
    </FrameLayout>

    <com.kdt.mcgui.mcVersionSpinner
        android:id="@+id/mc_version_spinner"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
</FrameLayout>