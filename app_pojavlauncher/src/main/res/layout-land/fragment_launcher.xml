<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/modrinth_native_background"
    android:theme="@style/ModrinthNativeTheme">

    <!-- Fixed-height header; the dashboard below is the 20/55/25 weighted split. -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/header_menu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_native_menu"
            android:contentDescription="Menu" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="4dp"
            android:src="@drawable/ic_modrinth"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ModrinthLauncher"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:layout_marginStart="16dp"
            android:background="#00F5D4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Made By: Macase, Nile"
            android:textColor="#00F5D4"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 20% sidebar / 55% dashboard / 25% controls. -->
    <LinearLayout
        android:id="@+id/dashboard_split"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- SIDEBAR: 20% -->
        <LinearLayout
            android:id="@+id/sidebar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.20"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <LinearLayout android:id="@+id/nav_home" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="2dp" android:gravity="center_vertical" android:paddingStart="12dp" android:background="@drawable/sidebar_active_pill" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_px_home" android:tint="#FFFFFF" android:contentDescription="@null"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Home" android:textColor="#FFFFFF" android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/nav_instances" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="2dp" android:gravity="center_vertical" android:paddingStart="12dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_px_experiment" android:tint="#EAF2FA" android:contentDescription="@null"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Instances" android:textColor="#FFFFFF" android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/nav_modpacks" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="2dp" android:gravity="center_vertical" android:paddingStart="12dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_px_experiment" android:tint="#EAF2FA" android:contentDescription="@null"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Modpacks" android:textColor="#FFFFFF" android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/nav_mods" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="2dp" android:gravity="center_vertical" android:paddingStart="12dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_px_experiment" android:tint="#EAF2FA" android:contentDescription="@null"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Mods" android:textColor="#FFFFFF" android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/nav_shaders" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="2dp" android:gravity="center_vertical" android:paddingStart="12dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_px_experiment" android:tint="#EAF2FA" android:contentDescription="@null"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Shaders" android:textColor="#FFFFFF" android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/nav_worlds" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="2dp" android:gravity="center_vertical" android:paddingStart="12dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_px_experiment" android:tint="#EAF2FA" android:contentDescription="@null"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Worlds" android:textColor="#FFFFFF" android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/nav_resource_packs" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="2dp" android:gravity="center_vertical" android:paddingStart="12dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_px_folder" android:tint="#EAF2FA" android:contentDescription="@null"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Resource Packs" android:textColor="#FFFFFF" android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/nav_servers" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="2dp" android:gravity="center_vertical" android:paddingStart="12dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_px_book" android:tint="#EAF2FA" android:contentDescription="@null"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Servers" android:textColor="#FFFFFF" android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/nav_settings" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="2dp" android:gravity="center_vertical" android:paddingStart="12dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_sharp_settings_24" android:tint="#EAF2FA" android:contentDescription="@null"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Settings" android:textColor="#FFFFFF" android:textSize="14sp"/>
            </LinearLayout>

            <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>

            <RelativeLayout
                android:id="@+id/nav_profile"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:padding="8dp"
                android:background="@drawable/native_outline"
                android:clickable="true"
                android:focusable="true">

                <ImageView android:id="@+id/profile_icon" android:layout_width="48dp" android:layout_height="48dp" android:layout_centerVertical="true" android:src="@drawable/ic_modrinth" android:contentDescription="@null"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/profile_icon" android:layout_marginStart="6dp" android:text="Modrinth" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/profile_icon" android:layout_below="@id/profile_icon" android:layout_marginStart="6dp" android:text="Better Minecraft Together" android:textColor="#B7C9D8" android:textSize="9sp"/>
            </RelativeLayout>
        </LinearLayout>

        <!-- CENTER: 55% -->
        <LinearLayout
            android:id="@+id/center_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.55"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="10dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/hero_banner"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:clipToOutline="true"
                app:cardBackgroundColor="#0B3540"
                app:strokeColor="#00F5D4"
                app:strokeWidth="1dp"
                app:cardCornerRadius="12dp">

                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                    <ImageView android:id="@+id/hero_art" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null"/>
                    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#70061018"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="“Play, Explore, Create, Together.”" android:textColor="#FFFFFF" android:textSize="23sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="The best Minecraft experience, now on your Android device." android:textColor="#FFFFFF" android:textSize="13sp"/>
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- RecyclerView itself wraps its children; cards no longer get clipped by a fixed RecyclerView height. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/instance_recycler"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_native_star" android:contentDescription="@null"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Latest Mods" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/view_all_mods" android:layout_width="90dp" android:layout_height="32dp" android:minHeight="0dp" android:minWidth="0dp" android:text="▦  View All" android:textAllCaps="false" android:textSize="10sp" android:textColor="#00F5D4" app:backgroundTint="#081B25" app:strokeColor="#00A995" app:strokeWidth="1dp" app:cornerRadius="16dp"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mod_recycler"
                android:layout_width="match_parent"
                android:layout_height="102dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>

        <!-- RIGHT: 25% -->
        <LinearLayout
            android:id="@+id/right_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.25"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/add_account_card"
                android:layout_width="match_parent"
                android:layout_height="106dp"
                app:cardBackgroundColor="#0A2029"
                app:strokeColor="#00F5D4"
                app:strokeWidth="1dp"
                app:cardCornerRadius="12dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Add Account" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sign in to your Minecraft account" android:textColor="#B7C9D8" android:textSize="10sp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/add_account_button" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="5dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="＋  Add Account" android:textAllCaps="false" android:textColor="#FFFFFF" app:backgroundTint="#061B25" app:strokeColor="#00F5D4" app:strokeWidth="1dp" app:cornerRadius="17dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/check_updates_button"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="7dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:gravity="center"
                android:text="⟳  Check Updates"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#0A2029"
                app:strokeColor="#00F5D4"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="7dp"
                app:cardBackgroundColor="#0A2029"
                app:strokeColor="#00F5D4"
                app:strokeWidth="1dp"
                app:cardCornerRadius="12dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UrinthUltra Mode" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Enable ultra performance mode" android:textColor="#B7C9D8" android:textSize="9sp"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/urinth_ultra_switch"
                        android:layout_width="54dp"
                        android:layout_height="36dp"
                        android:checked="false"
                        android:textOff="OFF"
                        android:textOn="ON"
                        app:showText="true"
                        app:trackTint="@color/modrinth_switch_track_tint"
                        app:thumbTint="@color/modrinth_switch_thumb_tint"
                        android:contentDescription="Toggle UrinthUltra Mode" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/discord_button"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="7dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="◉  Discord                                      ›"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#243A8C"
                app:strokeColor="#00F5D4"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>

    <com.kdt.mcgui.mcVersionSpinner
        android:id="@+id/mc_version_spinner"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
</LinearLayout>