<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragment_menu_main" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="#07131D">

    <LinearLayout android:id="@+id/modrinth_sidebar" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="0.18" android:orientation="vertical" android:padding="16dp" android:background="#0B1722">
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical">
            <ImageView android:layout_width="38dp" android:layout_height="38dp" android:src="@drawable/ic_modrinth" android:contentDescription="@null"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp"
                android:text="ModrinthLauncher" android:textColor="#F4F8FB" android:textSize="16sp" android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            android:text="Made By: Macase, Nile" android:textColor="#7C93A5" android:textSize="10sp"/>
        <TextView android:id="@+id/modrinth_home" style="@style/ModrinthNav" android:text="Home"/>
        <TextView android:id="@+id/modrinth_instances" style="@style/ModrinthNav" android:text="Instances"/>
        <TextView android:id="@+id/modrinth_modpacks" style="@style/ModrinthNav" android:text="Modpacks"/>
        <TextView android:id="@+id/modrinth_mods" style="@style/ModrinthNav" android:text="Mods"/>
        <TextView android:id="@+id/modrinth_shaders" style="@style/ModrinthNav" android:text="Shaders"/>
        <TextView android:id="@+id/modrinth_worlds" style="@style/ModrinthNav" android:text="Worlds"/>
        <TextView android:id="@+id/modrinth_resourcepacks" style="@style/ModrinthNav" android:text="Resource Packs"/>
        <TextView android:id="@+id/modrinth_servers" style="@style/ModrinthNav" android:text="Servers"/>
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
        <TextView android:id="@+id/modrinth_settings" style="@style/ModrinthNav" android:text="Settings"/>
    </LinearLayout>

    <ScrollView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.82" android:fillViewport="true" android:background="#0F1B25">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="150dp" android:orientation="vertical" android:padding="22dp" android:background="#123C46">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Play, Explore, Create, Together."
                    android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="The best Minecraft experience, now on your Android device." android:textColor="#B9D8DE" android:textSize="13sp"/>
                <TextView android:id="@+id/hero_play" style="@style/ModrinthPlay" android:layout_width="110dp" android:layout_height="34dp"
                    android:layout_marginTop="12dp" android:text="PLAY"/>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
                android:text="Instances" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="145dp" android:layout_marginTop="10dp" android:orientation="horizontal">
                <LinearLayout style="@style/ModrinthCard" android:layout_weight="1"><TextView style="@style/ModrinthCardTitle" android:text="URinthH"/>
                    <TextView style="@style/ModrinthCardMeta" android:text="Vanilla 26.3"/><TextView android:id="@+id/instance_play_1" style="@style/ModrinthPlay" android:text="PLAY"/></LinearLayout>
                <LinearLayout style="@style/ModrinthCard" android:layout_weight="1"><TextView style="@style/ModrinthCardTitle" android:text="URinthH"/>
                    <TextView style="@style/ModrinthCardMeta" android:text="Vanilla 26.3"/><TextView android:id="@+id/instance_play_2" style="@style/ModrinthPlay" android:text="PLAY"/></LinearLayout>
                <LinearLayout style="@style/ModrinthCard" android:layout_weight="1"><TextView style="@style/ModrinthCardTitle" android:text="URinthH"/>
                    <TextView style="@style/ModrinthCardMeta" android:text="Vanilla 26.3"/><TextView android:id="@+id/instance_play_3" style="@style/ModrinthPlay" android:text="PLAY"/></LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="82dp" android:layout_marginTop="12dp" android:orientation="horizontal">
                <TextView android:id="@+id/add_account_card" style="@style/ModrinthAction" android:text="ADD ACCOUNT"/>
                <TextView android:id="@+id/check_updates_card" style="@style/ModrinthAction" android:text="CHECK UPDATES"/>
                <TextView android:id="@+id/ultra_card" style="@style/ModrinthAction" android:text="UrInthUltra Mode&#10;OFF"/>
                <TextView android:id="@+id/discord_card" style="@style/ModrinthAction" android:text="DISCORD"/>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
                android:text="Latest Mods" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="105dp" android:layout_marginTop="10dp" android:orientation="horizontal">
                <TextView style="@style/ModrinthLatest" android:text="Modrinth&#10;Minecraft"/>
                <TextView style="@style/ModrinthLatest" android:text="Latest Mod"/>
                <TextView style="@style/ModrinthLatest" android:text="Latest Mod"/>
            </LinearLayout>
            <com.kdt.mcgui.mcVersionSpinner android:id="@+id/mc_version_spinner" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>