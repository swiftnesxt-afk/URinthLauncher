<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#03121A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="#061821">

            <TextView
                android:id="@+id/nav_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="☰"
                android:textColor="#FFFFFF"
                android:textSize="22sp"/>

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="5dp"
                android:src="@drawable/ic_modrinth"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="ModrinthLauncher"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_marginStart="14dp"
                android:background="#00F5D4"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Made By: Macase, Nile"
                android:textColor="#00F5D4"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.15"
                android:orientation="vertical"
                android:paddingStart="7dp"
                android:paddingTop="5dp"
                android:paddingEnd="7dp">

                <LinearLayout android:id="@+id/nav_home" style="@style/ModrinthNavRow" android:background="@drawable/modrinth_nav_active">
                    <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_px_home" android:tint="#FFFFFF"/>
                    <TextView style="@style/ModrinthNavLabel" android:text="Home"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/nav_instances" style="@style/ModrinthNavRow">
                    <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_px_file" android:tint="#DDEDEE"/>
                    <TextView style="@style/ModrinthNavLabel" android:text="Instances"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/nav_modpacks" style="@style/ModrinthNavRow">
                    <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_px_folder" android:tint="#DDEDEE"/>
                    <TextView style="@style/ModrinthNavLabel" android:text="Modpacks"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/nav_mods" style="@style/ModrinthNavRow">
                    <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_px_experiment" android:tint="#DDEDEE"/>
                    <TextView style="@style/ModrinthNavLabel" android:text="Mods"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/nav_shaders" style="@style/ModrinthNavRow">
                    <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_px_image_renderer" android:tint="#DDEDEE"/>
                    <TextView style="@style/ModrinthNavLabel" android:text="Shaders"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/nav_worlds" style="@style/ModrinthNavRow">
                    <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_px_volcano" android:tint="#DDEDEE"/>
                    <TextView style="@style/ModrinthNavLabel" android:text="Worlds"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/nav_resources" style="@style/ModrinthNavRow">
                    <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_px_folder" android:tint="#DDEDEE"/>
                    <TextView style="@style/ModrinthNavLabel" android:text="Resource Packs"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/nav_servers" style="@style/ModrinthNavRow">
                    <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_px_console" android:tint="#DDEDEE"/>
                    <TextView style="@style/ModrinthNavLabel" android:text="Servers"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/nav_settings" style="@style/ModrinthNavRow">
                    <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_sharp_settings_24" android:tint="#DDEDEE"/>
                    <TextView style="@style/ModrinthNavLabel" android:text="Settings"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:padding="5dp"
                    android:background="@drawable/modrinth_card">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_modrinth"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Modrinth&#10;Better Minecraft Together" android:textColor="#FFFFFF" android:textSize="8sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#00F5D4" android:textSize="20sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.64"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:background="@drawable/modrinth_hero">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="“Play, Explore,&#10;Create, Together.”" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="The best Minecraft experience,&#10;now on your Android device." android:textColor="#E6FFFF" android:textSize="10sp"/>
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="116dp"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal">
                    <include android:id="@+id/instance_one" layout="@layout/modrinth_instance_card"/>
                    <include android:id="@+id/instance_two" layout="@layout/modrinth_instance_card"/>
                    <include android:id="@+id/instance_three" layout="@layout/modrinth_instance_card"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="★  Latest Mods" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/view_all_mods" android:layout_width="wrap_content" android:layout_height="25dp" android:gravity="center" android:paddingStart="9dp" android:paddingEnd="9dp" android:text="▦  View All" android:textColor="#00F5D4" android:textSize="10sp" android:background="@drawable/modrinth_outline"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:orientation="horizontal">
                    <include android:id="@+id/mod_sodium" layout="@layout/modrinth_mod_card"/>
                    <include android:id="@+id/mod_lithium" layout="@layout/modrinth_mod_card"/>
                    <include android:id="@+id/mod_iris" layout="@layout/modrinth_mod_card"/>
                    <include android:id="@+id/mod_distant" layout="@layout/modrinth_mod_card"/>
                    <include android:id="@+id/mod_xaero" layout="@layout/modrinth_mod_card"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.21"
                android:orientation="vertical"
                android:paddingEnd="7dp"
                android:paddingTop="1dp">

                <LinearLayout
                    android:id="@+id/add_account_button"
                    android:layout_width="match_parent"
                    android:layout_height="74dp"
                    android:padding="6dp"
                    android:orientation="vertical"
                    android:background="@drawable/modrinth_card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_modrinth"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="7dp" android:text="Add Account&#10;Sign in to your Minecraft account" android:textColor="#FFFFFF" android:textSize="9sp"/>
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center" android:text="＋  Add Account" android:textColor="#FFFFFF" android:textSize="9sp" android:background="@drawable/modrinth_outline"/>
                </LinearLayout>

                <TextView android:id="@+id/check_updates_button" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="6dp" android:gravity="center_vertical" android:paddingStart="9dp" android:text="⟳  Check Updates&#10;     Check for new versions and fixes        ›" android:textColor="#FFFFFF" android:textSize="9sp" android:background="@drawable/modrinth_card"/>
                <TextView android:id="@+id/ultra_button" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="6dp" android:gravity="center_vertical" android:paddingStart="9dp" android:text="🚀  UrinthUltra Mode&#10;     Enable ultra performance mode     OFF  ON" android:textColor="#FFFFFF" android:textSize="9sp" android:background="@drawable/modrinth_card"/>
                <TextView android:id="@+id/discord_button" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" android:gravity="center_vertical" android:padding="9dp" android:text="◉  Discord                                      ›" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/modrinth_discord"/>
                <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>