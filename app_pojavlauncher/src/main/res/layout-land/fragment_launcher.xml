<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#03131D"
    android:theme="@style/ModrinthNativeTheme">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="14dp">

        <ImageButton
            android:id="@+id/header_menu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_native_menu"
            android:contentDescription="Menu" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="3dp"
            android:src="@drawable/ic_modrinth"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ModrinthLauncher"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="25dp"
            android:layout_marginStart="14dp"
            android:background="#00F5D4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Made By: Macase, Nile"
            android:textColor="#00F5D4"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/content_split"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 14%: compact desktop-sized navigation. -->
        <LinearLayout
            android:id="@+id/sidebar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.14"
            android:orientation="vertical"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="5dp"
            android:paddingBottom="7dp">

            <LinearLayout
                android:id="@+id/nav_home"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginBottom="1dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="5dp"
                android:background="@drawable/sidebar_active_pill"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_px_home"
                    android:tint="#EAF2FA"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="9dp"
                    android:text="Home"
                    android:textColor="#F4F7FA"
                    android:textSize="12sp" />
            </LinearLayout>
<LinearLayout
                android:id="@+id/nav_instances"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginBottom="1dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="5dp"
                android:background="@drawable/sidebar_nav_ripple"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_px_experiment"
                    android:tint="#EAF2FA"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="9dp"
                    android:text="Instances"
                    android:textColor="#F4F7FA"
                    android:textSize="12sp" />
            </LinearLayout>
<LinearLayout
                android:id="@+id/nav_modpacks"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginBottom="1dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="5dp"
                android:background="@drawable/sidebar_nav_ripple"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_px_experiment"
                    android:tint="#EAF2FA"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="9dp"
                    android:text="Modpacks"
                    android:textColor="#F4F7FA"
                    android:textSize="12sp" />
            </LinearLayout>
<LinearLayout
                android:id="@+id/nav_mods"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginBottom="1dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="5dp"
                android:background="@drawable/sidebar_nav_ripple"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_px_experiment"
                    android:tint="#EAF2FA"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="9dp"
                    android:text="Mods"
                    android:textColor="#F4F7FA"
                    android:textSize="12sp" />
            </LinearLayout>
<LinearLayout
                android:id="@+id/nav_shaders"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginBottom="1dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="5dp"
                android:background="@drawable/sidebar_nav_ripple"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_px_experiment"
                    android:tint="#EAF2FA"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="9dp"
                    android:text="Shaders"
                    android:textColor="#F4F7FA"
                    android:textSize="12sp" />
            </LinearLayout>
<LinearLayout
                android:id="@+id/nav_worlds"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginBottom="1dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="5dp"
                android:background="@drawable/sidebar_nav_ripple"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_px_experiment"
                    android:tint="#EAF2FA"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="9dp"
                    android:text="Worlds"
                    android:textColor="#F4F7FA"
                    android:textSize="12sp" />
            </LinearLayout>
<LinearLayout
                android:id="@+id/nav_resource_packs"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginBottom="1dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="5dp"
                android:background="@drawable/sidebar_nav_ripple"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_px_folder"
                    android:tint="#EAF2FA"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="9dp"
                    android:text="Resource Packs"
                    android:textColor="#F4F7FA"
                    android:textSize="12sp" />
            </LinearLayout>
<LinearLayout
                android:id="@+id/nav_servers"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginBottom="1dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="5dp"
                android:background="@drawable/sidebar_nav_ripple"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_px_book"
                    android:tint="#EAF2FA"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="9dp"
                    android:text="Servers"
                    android:textColor="#F4F7FA"
                    android:textSize="12sp" />
            </LinearLayout>
<LinearLayout
                android:id="@+id/nav_settings"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginBottom="1dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="5dp"
                android:background="@drawable/sidebar_nav_ripple"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_sharp_settings_24"
                    android:tint="#EAF2FA"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="9dp"
                    android:text="Settings"
                    android:textColor="#F4F7FA"
                    android:textSize="12sp" />
            </LinearLayout>

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/nav_profile"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:padding="6dp"
                android:gravity="center_vertical"
                android:background="@drawable/native_outline"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_modrinth"
                    android:contentDescription="@null" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Modrinth"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Better Minecraft Together"
                        android:textColor="#A9BBC8"
                        android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 64%: hero, three instances, latest mods. -->
        <LinearLayout
            android:id="@+id/center_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.64"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/hero_banner"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                app:cardBackgroundColor="#09212A"
                app:strokeColor="#00F5D4"
                app:strokeWidth="1dp"
                app:cardCornerRadius="12dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/hero_art"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@null" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#55030A12" />

                    <LinearLayout
                        android:layout_width="58%"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="“Play, Explore,"
                            android:textColor="#FFFFFF"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Create, Together.”"
                            android:textColor="#FFFFFF"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="The best Minecraft experience,\nnow on your Android device."
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/instance_recycler"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="12dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false" />

            <LinearLayout
                android:id="@+id/latest_mods_header"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingStart="5dp"
                android:paddingEnd="2dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★  Latest Mods"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mods_view_all"
                    android:layout_width="82dp"
                    android:layout_height="30dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="View All"
                    android:textAllCaps="false"
                    android:textSize="9sp"
                    android:textColor="#00F5D4"
                    android:backgroundTint="#061B22"
                    app:strokeColor="#00F5D4"
                    app:strokeWidth="1dp"
                    app:cornerRadius="15dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mod_recycler"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>

        <!-- 22%: restored right-side controls. -->
        <LinearLayout
            android:id="@+id/right_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.22"
            android:orientation="vertical"
            android:paddingStart="7dp"
            android:paddingEnd="9dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="72dp"
                app:cardBackgroundColor="#061D26"
                app:strokeColor="#087C7C"
                app:strokeWidth="1dp"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="7dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Add Account"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sign in to your Minecraft account"
                        android:textColor="#A9BBC8"
                        android:textSize="9sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/add_account_button"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:minHeight="0dp"
                        android:text="＋  Add Account"
                        android:textAllCaps="false"
                        android:textSize="10sp"
                        android:textColor="#EAF2FA"
                        android:backgroundTint="#061D26"
                        app:strokeColor="#00F5D4"
                        app:strokeWidth="1dp"
                        app:cornerRadius="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/check_updates_button"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="10dp"
                android:text="⟳  Check Updates"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#EAF2FA"
                android:backgroundTint="#061D26"
                app:strokeColor="#087C7C"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#061D26"
                app:strokeColor="#087C7C"
                app:strokeWidth="1dp"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:padding="8dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="UrinthUltra Mode"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Enable ultra performance mode"
                            android:textColor="#A9BBC8"
                            android:textSize="8sp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/ultra_switch"
                        android:layout_width="54dp"
                        android:layout_height="32dp"
                        android:textOff="OFF"
                        android:textOn="ON"
                        app:showText="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/discord_button"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="10dp"
                android:text="☯  Discord     ›"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#273D9D"
                app:cornerRadius="12dp" />

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <com.kdt.mcgui.mcVersionSpinner
        android:id="@+id/mc_version_spinner"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
</LinearLayout>