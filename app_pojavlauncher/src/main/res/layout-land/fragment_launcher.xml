<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#03131F">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">

        <LinearLayout android:id="@+id/target_sidebar" android:layout_width="216dp" android:layout_height="match_parent" android:background="#04131E" android:orientation="vertical" android:paddingStart="10dp" android:paddingTop="10dp" android:paddingEnd="10dp">
            <Button android:id="@+id/target_menu_button" android:layout_width="48dp" android:layout_height="48dp" android:text="☰" android:textSize="27sp" android:textColor="#E8F2F7" android:background="@android:color/transparent"/>
            <TextView android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:paddingStart="10dp" android:text="◉  ModrinthLauncher" android:textStyle="bold" android:textSize="20sp" android:textColor="#F2F8FA"/>
            <Button android:id="@+id/target_home" android:layout_width="match_parent" android:layout_height="48dp" android:text="⌂   Home" android:gravity="center_vertical" android:textSize="15sp" android:textColor="#00F0C8" android:background="#0B665A"/>
            <Button android:id="@+id/target_instances" android:layout_width="match_parent" android:layout_height="44dp" android:text="◇   Instances" android:gravity="center_vertical" android:textSize="15sp" android:textColor="#E8F2F7" android:background="@android:color/transparent"/>
            <Button android:id="@+id/target_modpacks" android:layout_width="match_parent" android:layout_height="44dp" android:text="✚   Modpacks" android:gravity="center_vertical" android:textSize="15sp" android:textColor="#E8F2F7" android:background="@android:color/transparent"/>
            <Button android:id="@+id/target_mods" android:layout_width="match_parent" android:layout_height="44dp" android:text="✚   Mods" android:gravity="center_vertical" android:textSize="15sp" android:textColor="#E8F2F7" android:background="@android:color/transparent"/>
            <Button android:id="@+id/target_shaders" android:layout_width="match_parent" android:layout_height="44dp" android:text="☼   Shaders" android:gravity="center_vertical" android:textSize="15sp" android:textColor="#E8F2F7" android:background="@android:color/transparent"/>
            <Button android:id="@+id/target_worlds" android:layout_width="match_parent" android:layout_height="44dp" android:text="◉   Worlds" android:gravity="center_vertical" android:textSize="15sp" android:textColor="#E8F2F7" android:background="@android:color/transparent"/>
            <Button android:id="@+id/target_resourcepacks" android:layout_width="match_parent" android:layout_height="44dp" android:text="▣   Resource Packs" android:gravity="center_vertical" android:textSize="15sp" android:textColor="#E8F2F7" android:background="@android:color/transparent"/>
            <Button android:id="@+id/target_servers" android:layout_width="match_parent" android:layout_height="44dp" android:text="☷   Servers" android:gravity="center_vertical" android:textSize="15sp" android:textColor="#E8F2F7" android:background="@android:color/transparent"/>
            <Button android:id="@+id/target_settings" android:layout_width="match_parent" android:layout_height="44dp" android:text="⚙   Settings" android:gravity="center_vertical" android:textSize="15sp" android:textColor="#E8F2F7" android:background="@android:color/transparent"/>
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
            <Button android:id="@+id/target_brand" android:layout_width="match_parent" android:layout_height="80dp" android:text="◉  Modrinth&#10;    Better Minecraft&#10;    Together   ›" android:gravity="center_vertical" android:textSize="12sp" android:textColor="#E8F2F7" android:background="#06231F"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp" android:paddingTop="8dp" android:paddingEnd="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Modrinth" android:textStyle="bold" android:textSize="24sp" android:textColor="#F4F7FA"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Launcher" android:textStyle="bold" android:textSize="24sp" android:textColor="#00EBC2"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:text="|   Made By: Macase, Nile" android:textSize="12sp" android:textColor="#00EBC2"/>
            </LinearLayout>

            <Button android:id="@+id/target_hero" android:layout_width="match_parent" android:layout_height="190dp" android:gravity="center_vertical|start" android:paddingStart="20dp" android:text="“Play, Explore,&#10;Create, Together.”&#10;&#10;The best Minecraft experience,&#10;now on your Android device." android:textAlignment="viewStart" android:textSize="18sp" android:textColor="#F6F8FA" android:background="#16455A"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="178dp" android:layout_marginTop="12dp" android:orientation="horizontal">
                <Button android:id="@+id/play_button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="URinthH&#10;Vanilla 26.3&#10;&#10;▷  Play    ⋮" android:textSize="15sp" android:textColor="#F7FAFC" android:gravity="bottom|start" android:padding="14dp" android:background="#174B4C"/>
                <Button android:id="@+id/target_instance_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:text="URinthH&#10;Vanilla 26.3&#10;&#10;▷  Play    ⋮" android:textSize="15sp" android:textColor="#F7FAFC" android:gravity="bottom|start" android:padding="14dp" android:background="#16405A"/>
                <Button android:id="@+id/target_instance_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="6dp" android:text="URinthH&#10;Vanilla 26.3&#10;&#10;▷  Play    ⋮" android:textSize="15sp" android:textColor="#F7FAFC" android:gravity="bottom|start" android:padding="14dp" android:background="#5A4018"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="★  Latest Mods" android:textSize="19sp" android:textStyle="bold" android:textColor="#F2F7FA"/>
                <Button android:id="@+id/target_view_all" android:layout_width="110dp" android:layout_height="38dp" android:text="▦  View All" android:textSize="12sp" android:textColor="#00EBC2" android:background="#07201F"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="105dp" android:orientation="horizontal">
                <Button android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="5dp" android:text="◉  Sodium&#10;     NeoForge 1.21.1&#10;     Add" android:textColor="#E8F2F7" android:gravity="center_vertical|start" android:background="#08212D"/>
                <Button android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:text="ϟ  Lithium&#10;     Fabric 1.21.1&#10;     Add" android:textColor="#E8F2F7" android:gravity="center_vertical|start" android:background="#08212D"/>
                <Button android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:text="✿  Iris&#10;     Fabric 1.21.1&#10;     Add" android:textColor="#E8F2F7" android:gravity="center_vertical|start" android:background="#08212D"/>
                <Button android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:text="◉  Distant Horizons&#10;     Forge 1.21.1&#10;     Add" android:textColor="#E8F2F7" android:gravity="center_vertical|start" android:background="#08212D"/>
                <Button android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:text="◉  Xaero's Minimap&#10;     Forge 1.21.1&#10;     Add" android:textColor="#E8F2F7" android:gravity="center_vertical|start" android:background="#08212D"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="318dp" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
            <Button android:id="@+id/target_add_account" android:layout_width="match_parent" android:layout_height="106dp" android:text="▣  Add Account&#10;    Sign in to your Minecraft account&#10;&#10;    ⊕  Add Account" android:textColor="#F2F7FA" android:textSize="14sp" android:gravity="center_vertical|start" android:background="#061B27"/>
            <Button android:id="@+id/target_updates" android:layout_width="match_parent" android:layout_height="70dp" android:layout_marginTop="10dp" android:text="◉  Check Updates&#10;    Check for new versions and fixes     ›" android:textColor="#F2F7FA" android:textSize="13sp" android:gravity="center_vertical|start" android:background="#061B27"/>
            <Button android:id="@+id/target_ultra" android:layout_width="match_parent" android:layout_height="70dp" android:layout_marginTop="10dp" android:text="🚀  UrinthUltra Mode&#10;     Enable ultra performance mode       OFF   ON" android:textColor="#F2F7FA" android:textSize="13sp" android:gravity="center_vertical|start" android:background="#061B27"/>
            <Button android:id="@+id/social_media_button" android:layout_width="match_parent" android:layout_height="76dp" android:layout_marginTop="10dp" android:text="◉  Discord                                      ›" android:textColor="#F2F7FA" android:textSize="16sp" android:gravity="center_vertical|start" android:background="#273FA5"/>
        </LinearLayout>
    </LinearLayout>

    <com.kdt.mcgui.mcVersionSpinner android:id="@+id/mc_version_spinner" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <ImageButton android:id="@+id/edit_profile_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <View android:id="@+id/_background_display_view" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <LinearLayout android:id="@+id/target_hidden" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone">
        <Button android:id="@+id/news_button" android:layout_width="1dp" android:layout_height="1dp"/>
        <Button android:id="@+id/custom_control_button" android:layout_width="1dp" android:layout_height="1dp"/>
        <Button android:id="@+id/install_jar_button" android:layout_width="1dp" android:layout_height="1dp"/>
        <Button android:id="@+id/share_logs_button" android:layout_width="1dp" android:layout_height="1dp"/>
        <Button android:id="@+id/open_files_button" android:layout_width="1dp" android:layout_height="1dp"/>
    </LinearLayout>
</FrameLayout>